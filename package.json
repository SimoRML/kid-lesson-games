{
  "name": "@simorml/kid-lesson-games",
  "version": "0.2.0",
  "private": true,
  "description": "Pluggable mini web games collection for youngsters",
  "type": "module",
  "main": "./dist/kid-games.umd.js",
  "module": "./dist/kid-games.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/kid-games.es.js",
      "require": "./dist/kid-games.umd.js",
      "default": "./dist/kid-games.es.js"
    },
    "./dist/*": "./dist/*"
  },
  "sideEffects": [
    "./dist/kid-games.es.js",
    "./dist/kid-games.umd.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimoRML/kid-lesson-games.git"
  },
  "bugs": {
    "url": "https://github.com/SimoRML/kid-lesson-games/issues"
  },
  "homepage": "https://github.com/SimoRML/kid-lesson-games#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "tsc && vite build && npm run build:types",
    "build:pages": "tsc && vite build --mode pages",
    "prepack": "npm run build",
    "preview": "vite preview",
    "create-game": "node scripts/create-game.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "education",
    "games",
    "web-component",
    "kids",
    "math",
    "physics"
  ],
  "author": "Simo (@SimoRML)",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "matter-js": "^0.20.0"
  }
}
